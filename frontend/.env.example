# Optional overrides. Defaults work for local development. No secrets are used anywhere in this project.
# NEXT_PUBLIC_RPC_URL: JSON-RPC endpoint used for reading the chain (default = local node or public Sepolia RPC)
# NEXT_PUBLIC_ML_URL : ML + report API (on Vercel set this to your Render URL, e.g. https://voltachain-api.onrender.com)
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_ML_URL=http://127.0.0.1:8000
