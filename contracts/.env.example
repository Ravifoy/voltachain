# Copy this file to .env and fill it in. .env is git-ignored - NEVER share or commit it.
# Used only when deploying to the Sepolia public testnet (npx hardhat run ... --network sepolia)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key of a FRESH wallet used only for this project (MetaMask > Account details > Show private key)
DEPLOYER_PRIVATE_KEY=0xPASTE_YOUR_FRESH_WALLET_KEY_HERE
# Where the ML/report API is running (seed script posts reports here)
ML_URL=http://127.0.0.1:8000
